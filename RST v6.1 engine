"""
RST v6.1 engine: spectral graph metrics for multichannel EEG.

What this module computes (all return plain numbers / arrays):
  - band-pass filtering
  - coherence-weighted channel graph
  - graph Laplacian, algebraic connectivity (lambda_2), Fiedler vector
  - RSN, defined here relative to an awake baseline (see rsn())
  - spectral entropy
  - theta-gamma coupling (modulation index, Tort et al. 2010 method)
  - an EXPERIMENTAL t* function from the v6.1 scaling law

Status of the ideas:
  - lambda_2, Fiedler vector, coherence graph, entropy and modulation index
    are standard, well-defined computations.
  - RSN as "lambda_2 / awake-baseline lambda_2" is a PROPOSED definition,
    not a validated one.
  - predicted_t_star() implements a hypothesis. Nothing here tests it.
  - Frequencies such as 39 Hz are fitted parameters from the project's own
    datasets, not universal constants. They are inputs here, never hardcoded.
"""

import numpy as np
from scipy.signal import butter, sosfiltfilt, coherence, hilbert, welch


# ---------------------------------------------------------------- filtering
def bandpass(data, fs, low, high, order=4):
    """Zero-phase Butterworth band-pass along the last axis."""
    data = np.asarray(data, dtype=float)
    nyq = fs / 2.0
    if not (0 < low < high < nyq):
        raise ValueError(f"Need 0 < low < high < Nyquist ({nyq} Hz); got {low}, {high}")
    sos = butter(order, [low / nyq, high / nyq], btype="band", output="sos")
    return sosfiltfilt(sos, data, axis=-1)


# -------------------------------------------------------------------- graph
def coherence_graph(data, fs, band=(30.0, 45.0), nperseg=None):
    """
    Weighted adjacency matrix from mean magnitude-squared coherence in `band`.

    data: array (n_channels, n_samples)
    Returns W: symmetric (n_channels, n_channels), zero diagonal, values in [0, 1].
    """
    data = np.asarray(data, dtype=float)
    if data.ndim != 2:
        raise ValueError("data must be 2D: (n_channels, n_samples)")
    n_ch, n_samp = data.shape
    if n_ch < 2:
        raise ValueError("Need at least 2 channels")
    if nperseg is None:
        nperseg = int(min(n_samp, max(fs, 256)))  # about 1 s segments
    W = np.zeros((n_ch, n_ch))
    for i in range(n_ch):
        for j in range(i + 1, n_ch):
            f, cxy = coherence(data[i], data[j], fs=fs, nperseg=nperseg)
            mask = (f >= band[0]) & (f <= band[1])
            if not mask.any():
                raise ValueError("No frequency bins in band; check band/nperseg/fs")
            W[i, j] = W[j, i] = float(np.mean(cxy[mask]))
    return W


def laplacian(W):
    """Combinatorial Laplacian L = D - W."""
    W = np.asarray(W, dtype=float)
    if W.ndim != 2 or W.shape[0] != W.shape[1]:
        raise ValueError("W must be square")
    if not np.allclose(W, W.T):
        raise ValueError("W must be symmetric")
    return np.diag(W.sum(axis=1)) - W


def spectral_metrics(W):
    """
    lambda_2 (algebraic connectivity), Fiedler vector, and lambda_3/lambda_2.

    Uses eigh (symmetric solver), so eigenvalues are real and sorted ascending.
    The spectral gap ratio is nan when lambda_2 is ~0 (disconnected graph).
    """
    L = laplacian(W)
    vals, vecs = np.linalg.eigh(L)
    vals = np.clip(vals, 0.0, None)  # remove tiny negative round-off
    lam2 = float(vals[1])
    fiedler = vecs[:, 1]
    lam3 = float(vals[2]) if len(vals) > 2 else float("nan")
    ratio = lam3 / lam2 if lam2 > 1e-12 and not np.isnan(lam3) else float("nan")
    return {
        "lambda_2": lam2,
        "fiedler_vector": fiedler,
        "spectral_gap_ratio": ratio,
        "eigenvalues": vals,
    }


def sliding_lambda2(data, fs, win_s=10.0, step_s=2.0, band=(30.0, 45.0)):
    """lambda_2 over time. Returns (window_start_times_s, lambda_2_values)."""
    data = np.asarray(data, dtype=float)
    win = int(win_s * fs)
    step = int(step_s * fs)
    if win > data.shape[1]:
        raise ValueError("Window longer than recording")
    times, lam = [], []
    for start in range(0, data.shape[1] - win + 1, step):
        W = coherence_graph(data[:, start:start + win], fs, band=band)
        lam.append(spectral_metrics(W)["lambda_2"])
        times.append(start / fs)
    return np.array(times), np.array(lam)


# ---------------------------------------------------------------------- RSN
def rsn(lambda_2, baseline_lambda_2):
    """
    PROPOSED definition: RSN = lambda_2 / baseline lambda_2, where the baseline
    is the same person's awake resting-state lambda_2.

    Intended reading (hypothesis): below 1 less connected, about 1 baseline,
    above 1 more connected. Because a measured value is never exactly 1, decide
    a tolerance band (for example 0.9 to 1.1) before analysing data.
    """
    if baseline_lambda_2 <= 0:
        raise ValueError("baseline_lambda_2 must be > 0")
    return float(lambda_2) / float(baseline_lambda_2)


# ------------------------------------------------------------------ entropy
def spectral_entropy(signal, fs, fmin=1.0, fmax=45.0, normalize=True):
    """
    Shannon entropy (bits) of the Welch PSD within [fmin, fmax].
    normalize=True divides by log2(n_bins) so the result is in [0, 1].
    """
    signal = np.asarray(signal, dtype=float)
    f, pxx = welch(signal, fs=fs, nperseg=int(min(len(signal), max(fs * 2, 256))))
    mask = (f >= fmin) & (f <= fmax)
    p = pxx[mask]
    if p.size < 2 or p.sum() <= 0:
        raise ValueError("Not enough spectral content in range")
    p = p / p.sum()
    h = float(-np.sum(p * np.log2(p + 1e-12)))
    return h / np.log2(p.size) if normalize else h


def peak_frequency(signal, fs, fmin=1.0, fmax=45.0):
    """Frequency of the largest Welch PSD peak in [fmin, fmax]."""
    signal = np.asarray(signal, dtype=float)
    f, pxx = welch(signal, fs=fs, nperseg=int(min(len(signal), max(fs * 2, 256))))
    mask = (f >= fmin) & (f <= fmax)
    return float(f[mask][np.argmax(pxx[mask])])


# ---------------------------------------------------- theta-gamma coupling
def modulation_index(signal, fs, phase_band=(4.0, 8.0), amp_band=(35.0, 43.0), n_bins=18):
    """
    Phase-amplitude coupling via the Tort et al. (2010) modulation index.
    Returns a value in [0, 1]: 0 means no coupling, larger means gamma
    amplitude is more tied to theta phase.

    This is the chi the v6.1 model calls the theta-gamma coupling index,
    under the assumption that chi is measured this way.
    """
    signal = np.asarray(signal, dtype=float)
    phase = np.angle(hilbert(bandpass(signal, fs, *phase_band)))
    amp = np.abs(hilbert(bandpass(signal, fs, *amp_band)))
    edges = np.linspace(-np.pi, np.pi, n_bins + 1)
    idx = np.clip(np.digitize(phase, edges) - 1, 0, n_bins - 1)
    mean_amp = np.array([amp[idx == k].mean() if np.any(idx == k) else 0.0
                         for k in range(n_bins)])
    if mean_amp.sum() <= 0:
        return 0.0
    p = mean_amp / mean_amp.sum()
    kl = np.sum(p[p > 0] * np.log(p[p > 0] * n_bins))
    return float(kl / np.log(n_bins))


def mean_modulation_index(data, fs, **kwargs):
    """Average modulation index across channels (data: n_channels x n_samples)."""
    data = np.asarray(data, dtype=float)
    return float(np.mean([modulation_index(ch, fs, **kwargs) for ch in data]))


# ------------------------------------------------- EXPERIMENTAL scaling law
def predicted_t_star(lambda_2, chi, gamma):
    """
    EXPERIMENTAL. v6.1 scaling law: t* ~ 1 / (gamma * (lambda_2 * chi)^2).

    gamma (metabolic flux) cannot be measured from EEG, so the caller must
    supply it, in units consistent with how t* is to be read. The law is a
    hypothesis; this project's validation does not test it.
    """
    if gamma <= 0:
        raise ValueError("gamma must be > 0")
    product = lambda_2 * chi
    if product <= 0:
        return float("inf")  # no connectivity or no coupling: no finite stall time
    return 1.0 / (gamma * product ** 2)


# -------------------------------------------------------------- one-call API
def analyze(data, fs, baseline_lambda_2=None, gamma=None,
            graph_band=(30.0, 45.0), phase_band=(4.0, 8.0), amp_band=(35.0, 43.0)):
    """
    Full pass over one recording window. data: (n_channels, n_samples).
    Returns a dict of numbers. Optional outputs are None when inputs are missing.
    """
    data = np.asarray(data, dtype=float)
    W = coherence_graph(data, fs, band=graph_band)
    m = spectral_metrics(W)
    chi = mean_modulation_index(data, fs, phase_band=phase_band, amp_band=amp_band)
    mean_signal = data.mean(axis=0)
    out = {
        "lambda_2": m["lambda_2"],
        "spectral_gap_ratio": m["spectral_gap_ratio"],
        "fiedler_vector": m["fiedler_vector"],
        "chi_modulation_index": chi,
        "spectral_entropy": spectral_entropy(mean_signal, fs),
        "peak_frequency_hz": peak_frequency(mean_signal, fs),
        "rsn": rsn(m["lambda_2"], baseline_lambda_2) if baseline_lambda_2 else None,
        "t_star_experimental": (predicted_t_star(m["lambda_2"], chi, gamma)
                                if gamma else None),
    }
    return out
