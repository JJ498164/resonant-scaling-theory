FS = 250
RNG = np.random.default_rng(42)


def make_channels(n_ch, seconds, shared_amp, noise_amp=1.0, f=39.0):
    """n_ch channels = shared f-Hz source * shared_amp + independent noise."""
    t = np.arange(int(seconds * FS)) / FS
    src = np.sin(2 * np.pi * f * t + 0.3)
    return np.array([shared_amp * src + noise_amp * RNG.standard_normal(t.size)
                     for _ in range(n_ch)])


